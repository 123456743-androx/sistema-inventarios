<form action="/entrada" method="POST">


<label>ID Producto</label>

<input
name="producto"
placeholder="Ejemplo P001"
required>



<label>ID Categoría</label>

<input
name="id_categoria"
placeholder="Ejemplo 01"
required>



<label>Cantidad</label>

<input
type="number"
name="cantidad"
required>



<button>
Registrar Entrada
</button>


</form>

<hr>

<h2>Entradas Registradas</h2>

<table border="1">

<tr>

<th>Producto</th>

<th>Categoría</th>

<th>Cantidad</th>

<th>Fecha</th>

</tr>

<% entradas.forEach(entrada=>{ %>

<tr>

<td><%= entrada.producto %></td>

<td><%= entrada.id_categoria %></td>

<td><%= entrada.cantidad %></td>

<td><%= entrada.fecha.toLocaleDateString() %></td>

</tr>

<% }) %>

</table>